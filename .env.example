# Copie ce fichier en .env et remplis-le. Ne jamais committer .env.

# Meta Model API (dev.meta.ai)
MODEL_API_KEY=
# SPARK_MODEL=muse-spark-1.3
# SPARK_CHEAP_MODEL=muse-spark-1.3-contributor   # données publiques uniquement : Meta peut entraîner dessus

# Muse Glimmer servi par un fournisseur compatible OpenAI (Fireworks, Modal, Baseten) — optionnel pour l'instant
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
GLIMMER_MODEL=

# Laya : alias (multilingual, english) ou dossier du checkpoint fine-tuné (ex. ./models/laya-reflex)
LAYA_MODEL=multilingual
LAYA_BLOCK_THRESHOLD=0.97
LAYA_CLOSE_THRESHOLD=0.03
LAYA_RISKY_THRESHOLD=0.5

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=

# Pi-hole (docker compose up -d pihole)
PIHOLE_URL=http://localhost:8081
PIHOLE_PASSWORD=change-moi

OCR_LANGS=fra+eng
